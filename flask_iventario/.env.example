# =====================================================================
# Plantilla de Variables de Entorno - SummanPOS (flask_iventario)
# Copia este archivo como .env y completa los valores correspondientes
# =====================================================================

# --- Despliegue VPS ---
VPS_HOST=
VPS_USER=
VPS_PASSWORD=

# --- DockerHub ---
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_IMAGE=

# --- Base de Datos PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=summanpos_db
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=prefer

# --- Configuración General ---
ENV_FOLDER=dev
DOMAIN_NAME=localhost
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=
