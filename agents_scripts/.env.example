# Servidor VPS Contabo / OCI
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=

# Base de Datos PostgreSQL / SummanPOS
DB_HOST=postgres
DB_PORT=5432
DB_USER=summanpos_dev_user
DB_PASSWORD=
DB_NAME=summanpos_dev

# Tokens / API Keys
SECRET_KEY=
